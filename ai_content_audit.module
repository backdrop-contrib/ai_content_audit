<?php

/**
 * @file
 * AI Content Audit — identify and act on redundant/outdated/trivial content.
 *
 * Clusters semantically similar nodes via the AI Search vector index, scores
 * each cluster (similarity + age + traffic → composite), classifies via the
 * ROT framework (Redundant / Outdated / Trivial), and queues recommended
 * actions (prune, merge, flag, edit_proposed) for admin approval. No content
 * is mutated until an admin approves the proposed action.
 *
 * This file holds the small / always-loaded surface: hooks (permission, menu,
 * config, cron, ai_async callbacks, ai_tools), thin helper queries
 * (load_cluster, load_candidates, cluster_counts, live_cluster_counts), and
 * the central candidate-status writer ai_content_audit_update_candidate_status()
 * — which is the function reject-unwind and approve flow run through.
 *
 * Heavy logic is split across loaded-on-demand includes:
 *   - includes/ai_content_audit.scanner.inc   — scan / cluster pipeline.
 *   - includes/ai_content_audit.scoring.inc   — scoring + ROT classify.
 *   - includes/ai_content_audit.llm.inc       — summaries + AI draft edits.
 *   - includes/ai_content_audit.execute.inc   — apply approved actions.
 *   - includes/ai_content_audit.tools.inc     — AI agent tool definitions.
 *   - includes/ai_content_audit.admin.inc     — admin forms.
 */

/**
 * Implements hook_permission().
 */
function ai_content_audit_permission() {
  return [
    'administer ai content audit' => [
      'title' => t('Administer AI Content Audit'),
      'description' => t('Run scans, review clusters, and approve or reject proposed actions.'),
    ],
  ];
}

